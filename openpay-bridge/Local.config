<?xml version="1.0" encoding="utf-8"?>
<!--
    Configuración del comercio para el PinPad OpenPay (Perú).

    ============================================================
    ESTOS SON LOS VALORES DE SANDBOX (DEMO) que trae el SDK EGlobal.
    ============================================================
    - `hosturl = http://localhost:9000` apunta al simulador Flutter que se
      distribuye en `Sandbox_1.0.37/simulador_windows.exe` (ver README).
    - `afiliacion`/`idaplicacion`/`clavesecreta`/`numeroterminal` son las
      credenciales DEMO del ambiente sandbox de EGlobal (públicas).
    - IMPORTANTE: el SDK EGlobal SIEMPRE exige un PinPad físico por COM,
      incluso en sandbox. `pinpadconexion` debe apuntar al COM real del
      PPD (COM3, COM4, ...) — el sandbox solo suplanta el back-end (HTTP),
      no el PinPad. Sin PPD conectado, `/openpay/init` timeout-eará.
    - `android = 1` es la bandera que sugiere EGlobal para su ambiente
      demo; en producción cambia a `0`.
    ============================================================

    Para producción, EGlobal entrega credenciales propias del comercio y
    la `hosturl` cambia a la del ambiente productivo.
-->
<configuracion>
  <sdk>
    <logs value="1" />
    <pinpadconexion value="COM7" />
    <pinpadpuerto value="" />
    <pinpadtimeout value="45" />
    <android value="1" />
    <pinpadmensaje value="BBVA DEMO" />
    <rutabase value="" />
    <hosturl value="http://localhost:9000" />
    <hosttimeout value="45" />
    <urlproxy value="" />
    <puertoproxy value="" />
    <afiliacion value="0000002" />
    <monedaafiliacion value="PEN" />
    <claveoperador value="OPE001" />
    <numeroterminal value="1" />
    <idaplicacion value="7e8e667438cb00903250ae3cda9b4bc9398f8084bb46aff9495286bf344a695f" />
    <clavesecreta value="609a8c80-0134-48ce-b63f-2b8031268b09" />
  </sdk>
</configuracion>

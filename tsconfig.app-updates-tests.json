{
  "compilerOptions": {
    "strict": true,
    "outDir": "./.tmp-tests",
    "noEmit": false,
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2020",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "./src",
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] },
    "lib": ["ES2020", "DOM"],
    "types": ["node"],
    "resolveJsonModule": true
  },
  "include": [
    "src/services/AppUpdatesService.ts",
    "src/services/AppUpdatesService.test.ts",
    "src/types/appUpdates.ts"
  ]
}
